# ==========================================
# 1. Java REST Backend (Aiven Cloud PostgreSQL)
# ==========================================
# Replace with your actual Aiven connection details:
# Format: jdbc:postgresql://<HOST>:<PORT>/<DATABASE>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password

# Server Ports
BACKEND_PORT=8080

# ==========================================
# 2. Java WebSocket Server
# ==========================================
WS_PORT=8081

# ==========================================
# 3. React Frontend (Vite variables must start with VITE_)
# ==========================================
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8081/ws
